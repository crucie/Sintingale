# Copy to .env.local. Everything is optional: with no values the app runs in
# demo mode (in-memory ledger + simulated payments).

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MERCHANT_ID=m_demo

# --- Whitechain (settlement) ---
NEXT_PUBLIC_WHITECHAIN_CHAIN_ID=1874
NEXT_PUBLIC_WHITECHAIN_RPC_URL=https://rpc.ankr.com/whitechain_testnet
NEXT_PUBLIC_WHITECHAIN_EXPLORER_URL=https://testnet.whitechain.io
# Set both to switch checkout from simulated to real on-chain payments.
NEXT_PUBLIC_PAYMENT_ROUTER_ADDRESS=
NEXT_PUBLIC_USDT_ADDRESS=
NEXT_PUBLIC_USDT_DECIMALS=6

# --- Arkiv (ledger) ---
# Set ARKIV_ENABLED=true plus a funded key to write entities to the Arkiv testnet.
ARKIV_ENABLED=false
ARKIV_ACCESS_KEY=
ARKIV_PRIVATE_KEY=

# --- Server-only secrets (never prefix with NEXT_PUBLIC_) ---
RELAYER_PRIVATE_KEY=
RELAYER_ADDRESS=
SINTINGALE_API_KEY=sn_test_demo_key
CRON_SECRET=
INVOICE_GRACE_SEC=120
RELAYER_CONFIRMATIONS=1
