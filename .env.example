# Copy to .env. Everything is optional: with no values the app runs in
# demo mode (in-memory ledger + simulated payments).

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MERCHANT_ID=m_demo

# --- Whitechain (settlement) ---
NEXT_PUBLIC_WHITECHAIN_CHAIN_ID=1874
NEXT_PUBLIC_WHITECHAIN_RPC_URL=https://rpc.testnet.whitechain.io
NEXT_PUBLIC_WHITECHAIN_EXPLORER_URL=https://explorer.testnet.whitechain.io
# Printed by scripts/deploy.mjs. Router + USDT switch checkout from simulated to real payments.
NEXT_PUBLIC_PAYMENT_ROUTER_ADDRESS=
NEXT_PUBLIC_SPLITTER_ADDRESS=
NEXT_PUBLIC_USDT_ADDRESS=0xcedfB56113143d55b2358b8CFbB0dEB5Ad2f55a7
NEXT_PUBLIC_USDT_DECIMALS=6
SPLITTER_ALLOWED_TOKEN=0xcedfB56113143d55b2358b8CFbB0dEB5Ad2f55a7

# --- Deployment (scripts/deploy.mjs only) ---
DEPLOYER_PRIVATE_KEY=

# --- Arkiv (ledger, Rabdi testnet) ---
# Access key: https://hub.arkiv.network/access-keys   tGLM: https://hub.arkiv.network/faucet
ARKIV_ENABLED=false
ARKIV_ACCESS_KEY=
# Writes every entity; its address is the trusted $creator for receipts and entitlements.
ARKIV_PRIVATE_KEY=

# --- Server-only secrets (never prefix with NEXT_PUBLIC_) ---
RELAYER_PRIVATE_KEY=
RELAYER_ADDRESS=
SINTINGALE_API_KEY=sn_test_demo_key
CRON_SECRET=
# Signs session cookies and SIWE nonces. Generate with: openssl rand -hex 32
SESSION_SECRET=
# Host the SIWE message is bound to, e.g. sintingale.vercel.app. Defaults to the request host.
SIWE_DOMAIN=
INVOICE_GRACE_SEC=120
RELAYER_CONFIRMATIONS=1

# --- ENS (optional Teams & ENS feature, Ethereum Sepolia) ---
# The feature is OFF by default and is switched on per merchant in Dashboard -> Settings.
# Sepolia is only used for ENS reads; payments never touch it.
NEXT_PUBLIC_SEPOLIA_CHAIN_ID=11155111
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_ENS_APP_URL=https://sepolia.app.ens.domains
NEXT_PUBLIC_ENS_PARENT_NAME_HINT=
NONCE_TTL_SECONDS=300
INVITE_TTL_SECONDS=172800
# Seeded acme.demo identities on the in-memory ledger (never used with Arkiv). Set false to hide.
DEMO_IDENTITIES=true
