# Copy to .env and fill in every required value. Sintingale refuses to serve
# (503 NOT_CONFIGURED) until the required variables below are set.

# --- App (required) ---
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NEXT_PUBLIC_MERCHANT_ID=m_sintingale

# --- Whitechain settlement (required) ---
NEXT_PUBLIC_WHITECHAIN_CHAIN_ID=1874
NEXT_PUBLIC_WHITECHAIN_RPC_URL=https://rpc.testnet.whitechain.io
NEXT_PUBLIC_WHITECHAIN_EXPLORER_URL=https://explorer.testnet.whitechain.io
# Printed by scripts/deploy.mjs.
NEXT_PUBLIC_PAYMENT_ROUTER_ADDRESS=
NEXT_PUBLIC_USDT_ADDRESS=0xcedfB56113143d55b2358b8CFbB0dEB5Ad2f55a7
NEXT_PUBLIC_USDT_DECIMALS=6
# Optional: enables project invoices and revenue splits (Teams & ENS).
NEXT_PUBLIC_SPLITTER_ADDRESS=
SPLITTER_ALLOWED_TOKEN=0xcedfB56113143d55b2358b8CFbB0dEB5Ad2f55a7

# --- Arkiv ledger, Rabdi testnet (required) ---
# Access key: https://hub.arkiv.network/access-keys   tGLM: https://hub.arkiv.network/faucet
ARKIV_ACCESS_KEY=
# Writes every entity; its address is the trusted $creator for receipts and entitlements.
ARKIV_PRIVATE_KEY=

# --- Server-only secrets (required, never prefix with NEXT_PUBLIC_) ---
# Generate each with: openssl rand -hex 32
SINTINGALE_API_KEY=
SESSION_SECRET=
# Bearer token for GET /api/relayer/tick (Vercel Cron sends it automatically).
CRON_SECRET=
# Host the SIWE sign-in message is bound to, e.g. your-app.vercel.app.
SIWE_DOMAIN=
INVOICE_GRACE_SEC=120
RELAYER_CONFIRMATIONS=1

# --- Deployment only (scripts/deploy.mjs; do not set on the hosted app) ---
DEPLOYER_PRIVATE_KEY=

# --- ENS (optional Teams & ENS feature, Ethereum Sepolia) ---
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_ENS_PARENT_NAME_HINT=
